{
  "entities": {
    "Department": {
      "title": "Department",
      "description": "Organizational department for lead segregation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name", "active", "created_at"]
    },
    "LeadStatus": {
      "title": "LeadStatus",
      "description": "Disposition status for leads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "display_order": { "type": "number" },
        "active": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name", "category", "display_order", "active", "created_at"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User account profile for admin or telecaller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "TELECALLER"] },
        "active": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "full_name", "email", "role", "active", "created_at"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Sales customer lead record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lead_number": { "type": "string" },
        "customer_name": { "type": "string" },
        "mobile": { "type": "string" },
        "alternate_mobile": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "product": { "type": "string" },
        "amount": { "type": "number" },
        "department_id": { "type": "string" },
        "source": { "type": "string" },
        "status_id": { "type": "string" },
        "assigned_to": { "type": "string" },
        "assigned_at": { "type": "string" },
        "followup_date": { "type": "string" },
        "followup_time": { "type": "string" },
        "callback_date": { "type": "string" },
        "callback_time": { "type": "string" },
        "last_remark": { "type": "string" },
        "last_activity_at": { "type": "string" },
        "imported_at": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "lead_number", "customer_name", "mobile", "status_id", "created_at"]
    },
    "LeadActivity": {
      "title": "LeadActivity",
      "description": "Activity log record for call or status update",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lead_id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "old_status_id": { "type": "string" },
        "new_status_id": { "type": "string" },
        "remark": { "type": "string" },
        "activity_type": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "lead_id", "user_id", "new_status_id", "remark", "created_at"]
    },
    "Followup": {
      "title": "Followup",
      "description": "Scheduled follow-up or callback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lead_id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_mobile": { "type": "string" },
        "followup_type": { "type": "string", "enum": ["FOLLOW_UP", "CALL_BACK"] },
        "scheduled_date": { "type": "string" },
        "scheduled_time": { "type": "string" },
        "remark": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "CANCELLED"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "lead_id", "user_id", "followup_type", "scheduled_date", "status", "created_at"]
    },
    "LeadAssignment": {
      "title": "LeadAssignment",
      "description": "Audit trail for lead assignment changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lead_id": { "type": "string" },
        "assigned_from": { "type": "string" },
        "assigned_to": { "type": "string" },
        "assigned_by": { "type": "string" },
        "department_id": { "type": "string" },
        "assigned_at": { "type": "string" }
      },
      "required": ["id", "lead_id", "assigned_to", "assigned_at"]
    }
  },
  "firestore": {
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Collection of organizational departments"
    },
    "/lead_statuses/{statusId}": {
      "schema": "LeadStatus",
      "description": "Collection of lead statuses"
    },
    "/profiles/{profileId}": {
      "schema": "Profile",
      "description": "Collection of user profiles"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of customer leads"
    },
    "/lead_activities/{activityId}": {
      "schema": "LeadActivity",
      "description": "Historical timeline of lead activities"
    },
    "/followups/{followupId}": {
      "schema": "Followup",
      "description": "Scheduled followups and callbacks"
    },
    "/lead_assignments/{assignmentId}": {
      "schema": "LeadAssignment",
      "description": "Assignment audit records"
    }
  }
}
